{
  "name": "@mams/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build --workspace @mams/types && tsx watch src/index.ts",
    "build": "npm run build --prefix ../shared/types && tsc -p tsconfig.build.json",
    "build:docker": "npm run build:docker --prefix ../shared/types && tsc -p tsconfig.docker.json",
    "start": "node dist/index.js",
    "seed": "tsx seed/seed.ts",
    "seed:users": "tsx seed/ensureSeedUsers.ts",
    "seed:first-time-user": "tsx seed/firstTimeUser.ts",
    "seed:attendance": "tsx seed/seedAttendanceDays.ts",
    "seed:compliance-month": "tsx seed/complianceMonth.ts",
    "seed:compliance-today": "tsx seed/complianceToday.ts",
    "purge:bug-reports": "tsx seed/purgeBugReports.ts",
    "backfill:bug-public-ids": "tsx scripts/backfillBugPublicIds.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src seed tests --ext .ts"
  },
  "dependencies": {
    "@mams/types": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.5.0",
    "nodemailer": "^8.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
