NODE_ENV=development
PORT=3001
MONGO_URI=mongodb://localhost:27017/mams_dev
# Production (Atlas): copy from Atlas → Connect → Drivers. Never commit real credentials.
# MONGO_URI=<atlas-srv-connection-string>
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-32
JWT_REFRESH_SECRET=replace-me-with-openssl-rand-base64-32
# Generate: openssl rand -base64 32
# If .env was shared in a handoff, rotate MONGO_URI password + both JWT secrets — see docs/SECRET_ROTATION.md
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173
# Production — exact Netlify (or custom) web URL, no trailing slash:
# CORS_ORIGIN=https://maksonhrms.netlify.app
# PUBLIC_APP_URL=https://maksonhrms.netlify.app
LOG_LEVEL=debug
TZ=Asia/Kolkata
SMART_ANCHOR_VERSION=v2.0.0

# Compliance HR nightly autogen (00:00 IST). Set true on Render after verifying /compliance-attendance page.
COMPLIANCE_AUTOGEN_ENABLED=false
# REPORT_JOBS_ENABLED=false to disable the in-process background report runner
REPORT_JOBS_ENABLED=true

# Experimental unmask (set false to hide for client demo; restart server after change)
FEATURE_UNMASK_ENABLED=true

# Local directory for bug report screen recordings (relative to mams-server cwd)
# BUG_REPORT_MEDIA_DIR=./data/bug-reports

# Offline Vosk transcription (requires ffmpeg + Python vosk-service)
# VOSK_SERVICE_URL=http://127.0.0.1:8765
# VOSK_MODELS_DIR=./vosk-models
# FFMPEG_PATH=ffmpeg
# Run: npm run vosk:models && npm run dev:vosk
# SEED_ORG_ADMIN_EMAIL=org.admin@makson-group.com
# SEED_ORG_ADMIN_NAME=Organization Admin
# SEED_HR_ADMIN_EMAIL=hr.admin@makson-group.com
# SEED_HR_COMPLIANCE_EMAIL=hr.compliance@makson-group.com
# SEED_IT_ADMIN_EMAIL=it.admin@makson-group.com
# SEED_IT_ADMIN_NAME=IT Administrator
# SEED_DEFAULT_PASSWORD=makson2026
# SEED_HR_ADMIN_NAME=Priya Patel
# SEED_HR_COMPLIANCE_NAME=Compliance Auditor
# Demo anchor date — seeds attendance + audit for anchor-6..anchor+1 in addition to rolling IST window.
# SEED_DEMO_ANCHOR_DATE=2026-06-18

# Welcome email (NodeMailer) — set MAIL_ENABLED=true when SMTP is available
MAIL_ENABLED=false
# PUBLIC_APP_URL must match the URL users open in the browser (Netlify or custom domain).
PUBLIC_APP_URL=http://localhost:5173
# Mail module also accepts APP_PUBLIC_URL (alias used when MAIL_ENABLED=true).
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=MAMS <noreply@makson-group.com>
