# Leave empty for local / on-prem behind reverse proxy: browser calls same-origin /api.
# Docker on-prem (mams/docker-compose.onprem.yml + mams-web/Dockerfile) also leaves these empty —
# nginx proxies /api, /iclock, and /integrations/hanvon to the API container.
# Only set if the SPA and API are on different hosts (no trailing slash; do not append /api).
#   VITE_API_BASE_URL=http://192.168.1.10:8089
VITE_API_BASE_URL=
# Optional: public host devices use for /iclock. Empty → falls back to VITE_API_BASE_URL, then page origin.
#   VITE_DEVICE_API_BASE_URL=http://192.168.1.10:8089
VITE_DEVICE_API_BASE_URL=
# Experimental features (set false to hide for client demo; restart Vite after change)
VITE_FEATURE_UNMASK_ENABLED=true
VITE_FEATURE_AUTOGEN_DEMO_ENABLED=true

# Experimental features (set false to hide for client demo; restart Vite after change)
VITE_FEATURE_UNMASK_ENABLED=true
VITE_FEATURE_AUTOGEN_DEMO_ENABLED=true
