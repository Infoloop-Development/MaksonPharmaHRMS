# Leave empty for local dev: browser calls /api on Vite (:5173); Vite proxies to mams-server (:3001).
# Set a full URL only if you need a remote API (e.g. production build against a staging host).
VITE_API_BASE_URL=
# Experimental features (set false to hide for client demo; restart Vite after change)
VITE_FEATURE_UNMASK_ENABLED=true
VITE_FEATURE_AUTOGEN_DEMO_ENABLED=true
